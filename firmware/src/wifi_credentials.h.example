#ifndef WIFI_CREDENTIALS_H
#define WIFI_CREDENTIALS_H

/* Rename or copy this file to wifi_credentials.h and enter your local network credentials. */

/* Primary Network (e.g. Home Wi-Fi / Workshop router) */
#define WIFI_SSID               "Your_Home_WiFi_SSID"
#define WIFI_PASSWORD           "Your_Home_WiFi_Password"
#define BRAIN_SERVER_IP         "192.168.178.100" /* Local PC, Dev laptop, or Pi 5 */
#define BRAIN_SERVER_PORT       5005

/* Secondary / Fallback Network (e.g. Smartphone Hotspot / Field / Mobile Tethering) */
/* The staff will automatically failover to this AP if Primary is unreachable. */
#define WIFI_FALLBACK_SSID      "Your_Phone_Hotspot_SSID"
#define WIFI_FALLBACK_PASSWORD  "Your_Phone_Hotspot_Password"
#define BRAIN_FALLBACK_SERVER_IP "192.168.43.1" /* Phone Hotspot gateway, or Cloud VPS IP */
#define BRAIN_FALLBACK_SERVER_PORT 5005

#endif /* WIFI_CREDENTIALS_H */

